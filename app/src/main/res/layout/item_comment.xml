<?xml version="1.0" encoding="utf-8"?>
<!-- One comment of a discussion, filled by ui/discussion/CommentAdapter.
     The stripes on the left take the whole height of the row, so the thread lines of
     consecutive rows join and show which comment each reply answers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <!-- One stripe per parent, added by the adapter -->
    <LinearLayout
        android:id="@+id/comment_indent"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal" />

    <!-- The rounded box of this comment, its color depends on the depth (set by the adapter).
         The vertical margin is the space between two comments. -->
    <LinearLayout
        android:id="@+id/comment_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fold button, author, date and score on one line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Folds / unfolds the replies (bonus C7) -->
            <TextView
                android:id="@+id/comment_collapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingEnd="8dp"
                android:text="@string/comment_collapse"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Takes the free space, so the date and the score stay on the right -->
            <TextView
                android:id="@+id/comment_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="u/username" />

            <TextView
                android:id="@+id/comment_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="2h ago" />

            <TextView
                android:id="@+id/comment_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="▲ 1.2k ▼" />
        </LinearLayout>

        <!-- Replaced by "Deleted comment" or "Removed by a moderator" when needed -->
        <TextView
            android:id="@+id/comment_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam id est tempor, efficitur eros vitae." />

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
